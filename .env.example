TINKER_API_KEY=
ANTHROPIC_API_KEY=
# Modal auth comes from `modal setup` (~/.modal.toml); do not set empty MODAL_TOKEN_* here
HF_TOKEN=
WANDB_API_KEY=
# GITHUB_TOKEN is optional; `gh auth token` is used when unset
GITHUB_TOKEN=
# needed only if the Anthropic key is not scoped to a workspace (console -> Settings -> Workspaces -> ID)
ANTHROPIC_WORKSPACE_ID=
