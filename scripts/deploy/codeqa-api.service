[Unit]
Description=codeqa API (FastAPI, SSE)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/codeqa
EnvironmentFile=/opt/codeqa/.env
Environment=CODEQA_DATA_DIR=/opt/codeqa/data
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/.local/bin/uv run --no-sync uvicorn apps.api.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
